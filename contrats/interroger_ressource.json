{
  "type": "function",
  "function": {
    "name": "interroger_ressource",
    "description": "Extrait des données tabulaires d'une ressource indexée par l'API tabulaire. Permet la pagination, le filtrage par colonne et le tri. Ne fonctionne que si api_tabulaire est vrai dans lister_ressources ; sinon retourne le code ressource_non_indexee.",
    "parameters": {
      "type": "object",
      "properties": {
        "id_ressource": {
          "type": "string",
          "description": "Identifiant de la ressource, issu de lister_ressources."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Numéro de page (défaut : 1)."
        },
        "taille_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20,
          "description": "Nombre d'éléments par page (défaut : 20, max : 100)."
        },
        "filtre": {
          "type": "object",
          "description": "Filtre optionnel sur une colonne (une colonne a la fois).",
          "properties": {
            "colonne": {
              "type": "string",
              "description": "Nom de la colonne a filtrer."
            },
            "valeur": {
              "type": "string",
              "description": "Valeur de comparaison."
            },
            "operateur": {
              "type": "string",
              "enum": [
                "exact",
                "contient",
                "inferieur",
                "superieur",
                "strictement_inferieur",
                "strictement_superieur"
              ],
              "default": "exact",
              "description": "Operateur de comparaison (defaut : exact)."
            }
          },
          "required": [
            "colonne",
            "valeur"
          ]
        },
        "tri": {
          "type": "object",
          "description": "Tri optionnel sur une colonne.",
          "properties": {
            "colonne": {
              "type": "string",
              "description": "Nom de la colonne a trier."
            },
            "ordre": {
              "type": "string",
              "enum": [
                "croissant",
                "decroissant"
              ],
              "description": "Ordre de tri (croissant ou decroissant)."
            }
          }
        }
      },
      "required": [
        "id_ressource"
      ]
    },
    "returns": {
      "type": "object",
      "properties": {
        "statut": {
          "type": "string",
          "enum": [
            "succes",
            "erreur_parametres",
            "ressource_non_indexee",
            "echec_technique"
          ],
          "description": "Code de statut de l'opération."
        },
        "message": {
          "type": "string",
          "description": "Message d'erreur en cas d'échec, vide sinon."
        },
        "donnees": {
          "type": "object",
          "properties": {
            "total_lignes": {
              "type": "integer",
              "description": "Nombre total de lignes de la ressource."
            },
            "colonnes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Schéma détecté (noms des colonnes)."
            },
            "lignes": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Page courante de données."
            },
            "page": {
              "type": "integer",
              "description": "Numéro de la page retournée."
            },
            "recommandation": {
              "type": [
                "string",
                "null"
              ],
              "description": "Recommandation pour les volumes élevés (ex : 'volume_eleve_telechargement_brut_suggere')."
            },
            "page_suivante": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Numero de la page suivante si elle existe, null sinon. Paginer en incrementant page, a filtre et tri identiques."
            },
            "nb_tentatives": {
              "type": "integer",
              "description": "Nombre de tentatives de l'appel HTTP (1 = succès au premier essai)."
            },
            "motif": {
              "type": [
                "string",
                "null"
              ],
              "description": "Motif de l'échec HTTP (T7.1 : 'transitoire' après épuisement des tentatives, 'acces_refuse', 'ressource_supprimee', 'requete_invalide') ; en mode agentique, 'circuit_ouvert' (T7.7) quand le circuit breaker a intercepté l'appel. None en cas de succès."
            }
          },
          "required": [
            "total_lignes",
            "colonnes",
            "lignes",
            "page"
          ]
        }
      },
      "required": [
        "statut",
        "message",
        "donnees"
      ]
    }
  }
}
