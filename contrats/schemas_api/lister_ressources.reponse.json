{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openDataAgent:schemas_api/lister_ressources.reponse",
  "title": "Inventaire v2 reconstitue : detail /api/2/datasets/{id} + ressources paginees /api/2/datasets/{id}/resources/",
  "description": "Schema de validation du payload reconstitue par la couche HTTP (T11.3) : metadonnees du jeu (v2) et liste plate des ressources issue de la sous-ressource paginee, avant traitement par le coeur.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique du jeu de donnees."
    },
    "title": {
      "type": "string",
      "description": "Titre du jeu de donnees."
    },
    "slug": {
      "type": [
        "string",
        "null"
      ],
      "description": "Slug du jeu de donnees."
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "description": "URL de la fiche du jeu sur data.gouv.fr (v2)."
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date de creation (ISO 8601)."
    },
    "last_modified": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date de derniere modification des metadonnees (ISO 8601)."
    },
    "last_update": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date de derniere mise a jour d'une ressource (ISO 8601) ; source du mapping derniere_maj (T11.3)."
    },
    "license": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identifiant de la licence."
    },
    "organization": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Nom de l'organisation."
        },
        "badges": {
          "type": "array",
          "description": "Badges uData de l'organisation (chantier B T7.5).",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": true
    },
    "resources": {
      "type": "array",
      "description": "Inventaire complet des ressources du jeu (liste plate reconstituee depuis la sous-ressource paginee v2).",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique de la ressource."
          },
          "title": {
            "type": "string",
            "description": "Titre de la ressource."
          },
          "url": {
            "type": "string",
            "description": "URL de telechargement de la ressource."
          },
          "format": {
            "type": [
              "string",
              "null"
            ],
            "description": "Format declare de la ressource."
          },
          "mime": {
            "type": [
              "string",
              "null"
            ],
            "description": "Type MIME de la ressource."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Description de la ressource."
          },
          "filesize": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Taille du fichier en octets, null si inconnue."
          },
          "filetype": {
            "type": [
              "string",
              "null"
            ],
            "description": "Type d'hebergement (file = heberge sur la plateforme, remote sinon)."
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date de creation de la ressource (ISO 8601)."
          },
          "last_modified": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date de derniere modification (ISO 8601)."
          }
        },
        "required": [
          "id",
          "title",
          "url"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "id",
    "title",
    "resources"
  ],
  "additionalProperties": true
}